# Copier ce fichier en « .env » et remplir les valeurs. Ne jamais versionner le fichier .env.

# Port d'écoute du serveur Node
PORT=8787

# Adresse publique du site (liens dans les e-mails)
SITE_URL=https://commeunefleur.be

# Secret pour signer les jetons anti-spam : une longue chaîne aléatoire
# (par ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_SECRET=

# Tableau de bord /admin (laisser ADMIN_PASSWORD vide pour le désactiver)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Envoi des messages du formulaire par e-mail (SMTP).
# Avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=l'adresse Gmail,
# SMTP_PASS=un « mot de passe d'application » (compte Google → Sécurité → Validation en deux étapes).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=commeunefleurixelles@gmail.com

# Derrière un proxy (Nginx, Caddy, hébergeur) : lire l'IP réelle dans X-Forwarded-For
TRUST_PROXY=0
# En HTTPS uniquement : active HSTS et « upgrade-insecure-requests »
HSTS=0

# Si le site est hébergé ailleurs que l'API : domaines autorisés à appeler l'API (CORS), séparés par des virgules
ALLOWED_ORIGINS=

# Dossier du site construit (par défaut ../frontend/dist). Vide = ne pas servir le site.
# STATIC_DIR=

# Dossier des données (messages, statistiques…). Par défaut api/data
# DATA_DIR=
