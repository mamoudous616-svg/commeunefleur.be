---
// Emblème : une fleur à cinq pétales, au trait (reprise dans le favicon).
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className } = Astro.props;
const petals = [0, 72, 144, 216, 288];
---

<svg class:list={['brand-mark', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.5">
    {petals.map((deg) => <ellipse cx="16" cy="9.6" rx="3.9" ry="5.9" transform={`rotate(${deg} 16 16)`} />)}
  </g>
  <circle cx="16" cy="16" r="2.1" fill="currentColor" />
</svg>
