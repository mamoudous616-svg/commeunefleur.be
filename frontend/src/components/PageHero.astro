---
// En-tête des pages intérieures : fil d'Ariane, titre léger, chapô. Une brume végétale très douce
// en haut de page rappelle l'accueil sans charger l'écran.
import { hazeFor } from '../lib/photos.js';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumb: string;
  haze?: string;
}
const { eyebrow, title, lead, crumb, haze = 'hero' } = Astro.props;
const bg = hazeFor(haze);
---

<section class="page-hero">
  <div class="page-hero__bg" aria-hidden="true">
    <img src={bg.src} alt="" width={bg.width} height={bg.height} decoding="async" fetchpriority="high" />
  </div>
  <div class="wrap page-hero__inner">
    <nav class="breadcrumb hero-fade" aria-label="Fil d’Ariane">
      <ol role="list">
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <p class="eyebrow hero-fade">{eyebrow}</p>
    <h1 class="display page-hero__title hero-fade" set:html={title} />
    {lead && <p class="lead hero-fade">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding: calc(var(--header-h) + clamp(64px, 10vw, 128px)) 0 clamp(64px, 9vw, 112px);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0 0 auto;
    height: min(520px, 70%);
    z-index: -1;
    overflow: hidden;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
  }

  .page-hero__bg img {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    max-width: none;
    object-fit: cover;
    filter: blur(24px);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--stack);
    justify-items: start;
  }

  .page-hero__title {
    max-width: 16ch;
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 5.75rem);
  }

  .page-hero__title :global(em) {
    font-style: italic;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    font-size: var(--text-small);
    color: var(--moss);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--line-strong);
  }

  .breadcrumb a {
    color: var(--sepia);
  }

  .hero-fade {
    animation: rise-soft 800ms var(--ease-out) both;
  }

  .hero-fade:nth-child(2) {
    animation-delay: 70ms;
  }

  .hero-fade:nth-child(3) {
    animation-delay: 140ms;
  }

  .hero-fade:nth-child(4) {
    animation-delay: 210ms;
  }

  @keyframes rise-soft {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
  }
</style>
